{
  "schema_version": 1,
  "project": {
    "name": "Algorithm Animator Studio (OSS cleanup)",
    "summary": "React/Vite algorithm visualization, maze and long-video authoring with Piper, Supertonic, VieNeu, GPT-SoVITS, ElevenLabs and RVC/Applio TTS providers; unsupported legacy modules are being removed.",
    "stack": [
      "React 18",
      "TypeScript",
      "Vite",
      "Express",
      "Electron",
      "Remotion",
      "Three.js / React Three Fiber",
      "Phaser",
      "Vitest"
    ],
    "entrypoints": [
      {
        "path": "src/main.tsx",
        "role": "Browser bootstrap"
      },
      {
        "path": "src/App.tsx",
        "role": "Frontend route composition"
      },
      {
        "path": "server/index.ts",
        "role": "Express composition root"
      },
      {
        "path": "electron/main.cjs",
        "role": "Desktop main process"
      }
    ]
  },
  "policy": {
    "source_of_truth": "Source code, tests, and type definitions override this curated routing index when they disagree.",
    "default_domain_results": 2,
    "max_primary_files": 12,
    "max_primary_lines": 2400,
    "always_load": [
      {
        "path": "AGENTS.md",
        "role": "Repository-wide rules and guardrails"
      }
    ],
    "never_load_by_default": [
      ".env and credentials",
      "node_modules/** and build outputs",
      "models/** binary model data",
      "libs/VieNeu-TTS/** vendored source unless the task targets VieNeu internals",
      "src/components/ui/** generated primitives unless a primitive itself is being changed"
    ]
  },
  "domains": [
