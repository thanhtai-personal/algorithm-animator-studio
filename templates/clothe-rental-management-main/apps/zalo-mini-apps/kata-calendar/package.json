{
  "name": "kata-calendar",
  "private": true,
  "version": "0.1.0",
  "description": "KATA Calendar Zalo Mini App",
  "type": "module",
  "browserslist": [
    "Android >= 5",
    "IOS >= 9.3",
    "Edge >= 15",
    "Safari >= 9.1",
    "Chrome >= 49",
    "Firefox >= 31",
    "Samsung >= 5"
  ],
  "scripts": {
    "login": "zmp login",
    "start": "zmp start -P 5177",
    "deploy": "zmp deploy",
    "dev": "vite",
    "build": "tsc --noEmit --pretty false && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --pretty false",
    "lint:long-files": "node ../scripts/check-long-files.mjs",
    "lint:long-files:warn": "cross-env ZALO_LONG_FILE_GUARD_MODE=warn node ../scripts/check-long-files.mjs",
    "lint": "npm run lint:long-files:warn && eslint ."
  },
  "dependencies": {
    "@tanstack/react-query": "^5.83.0",
    "lucide-react": "^0.462.0",
    "mobx": "^6.15.0",
    "mobx-react-lite": "^4.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zmp-sdk": "^2.9.4",
    "zmp-ui": "latest"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "cross-env": "^7.0.3",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "postcss": "^8.4.38",
    "postcss-cli": "^8.3.1",
    "postcss-preset-env": "^11.2.0",
    "sass": "^1.76.0",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^5.2.13",
    "zmp-vite-plugin": "latest"
  }
}
