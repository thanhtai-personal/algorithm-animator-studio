# Frontend/runtime
VITE_API_URL=http://localhost:5050
VITE_PUBLIC_WEB=false
VITE_DESKTOP_DOWNLOAD_URL=

# Local voice backend
CLIENT_ORIGIN=http://localhost:3000
VITE_NEST_API_BASE_URL=https://kata-center-api.vercel.app/
SERVER_ORIGIN=http://localhost:5050
SERVER_DATA_DIR=server/data
MODEL_DIR=models
PIPER_EXE=models/.venv/Scripts/piper.exe

# ElevenLabs PRO voice
ELEVENLABS_API_KEY=
ELEVENLABS_VOICES=[]

# Supertonic local TTS server
SUPERTONIC_BASE_URL=http://127.0.0.1:6688
SUPERTONIC_MODEL=supertonic-3
SUPERTONIC_DEFAULT_VOICE=M1
SUPERTONIC_DEFAULT_LANG=en
SUPERTONIC_TOTAL_STEPS=8

# RVC/Applio local voice conversion provider
# Start Applio/RVC with Gradio API, then copy the endpoint template from "Use via API".
RVC_APPLIO_BASE_URL=http://127.0.0.1:6969
RVC_APPLIO_START_COMMAND=
RVC_APPLIO_API_NAME=/infer_convert
RVC_APPLIO_ARG_TEMPLATE_JSON=
RVC_APPLIO_PYTHON=python
RVC_APPLIO_SOURCE_PIPER_MODEL=vi_vais1000
RVC_APPLIO_MODEL_NAME=
RVC_APPLIO_INDEX_PATH=
RVC_APPLIO_PITCH=0
RVC_APPLIO_F0_METHOD=rmvpe
RVC_APPLIO_INDEX_RATE=0.75
RVC_APPLIO_PROTECT=0.33
RVC_APPLIO_FILTER_RADIUS=3
RVC_APPLIO_TIMEOUT_MS=1200000

# YouTube OAuth + upload - read by local/desktop backend only
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/channel
YOUTUBE_TITLE=Algorithm explained visually
YOUTUBE_DESCRIPTION=Visual programming explanation generated by KAI STUDIO.
YOUTUBE_TAGS=algorithm,programming,visualization,code visual lab,kai studio
YOUTUBE_CATEGORY_ID=27
YOUTUBE_PRIVACY_STATUS=unlisted
YOUTUBE_MADE_FOR_KIDS=false
YOUTUBE_NOTIFY_SUBSCRIBERS=false
YOUTUBE_CONTAINS_SYNTHETIC_MEDIA=true

# Social provider OAuth - read by local/desktop backend only
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/channel
TIKTOK_SCOPES=user.info.basic
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:3000/channel
FACEBOOK_SCOPES=pages_show_list,pages_read_engagement
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/channel
INSTAGRAM_SCOPES=instagram_basic,pages_show_list,pages_read_engagement

# MU News AI scripting - optional, server-side only
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
