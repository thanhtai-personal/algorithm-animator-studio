{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n client,server,supertonic,applio,vieneu,gptsovits -c cyan,green,magenta,yellow,blue,red \"npm run dev:client\" \"npm run dev:server\" \"npm run dev:supertonic\" \"npm run dev:applio\" \"npm run dev:vieneu\" \"npm run dev:gpt-sovits\"",
    "dev:remote": "concurrently -n remote-api,remote-ui -c green,cyan \"cross-env PORT=8891 CLIENT_ORIGIN=http://127.0.0.1:3891 tsx watch remote-control-app/server/remoteIndex.ts\" \"vite --config remote-control-app/vite.config.ts\"",
    "prod:local": "npm run build && node scripts/start-production-local.mjs",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:client": "vite --host 0.0.0.0 --port 3000",
    "dev:server": "tsx watch server/index.ts",
    "dev:supertonic": "npm run supertonic:serve",
    "dev:applio": "node scripts/start-applio.mjs",
    "applio:install": "python -m pip install -U gradio_client",
    "supertonic:install": "python -m pip install \"supertonic[serve]\"",
    "vieneu:install": "node scripts/install-vieneu-from-source.mjs",
    "vieneu:health": "node scripts/run-vieneu-health.mjs",
    "supertonic:serve": "node scripts/start-supertonic.mjs",
    "dev:full": "npm run dev",
    "start:server": "tsx server/index.ts",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-electron/server/index.js",
    "build:remote:renderer": "vite build --config remote-control-app/vite.config.ts",
    "build:remote:server": "esbuild remote-control-app/server/remoteIndex.ts --bundle --platform=node --format=cjs --outfile=remote-control-app/dist-server/index.cjs",
    "build:remote:prepare": "node remote-control-app/scripts/prepare-package.mjs",
    "build:remote:verify": "node remote-control-app/scripts/verify-build.mjs",
    "build:remote": "npm run build:remote:renderer && npm run build:remote:server && npm run build:remote:prepare && npm run build:remote:verify",
    "remote:preview": "npm run build:remote && npm run electron:install && electron remote-control-app/electron/main.cjs",
    "dist:remote:win:unpacked": "npm run build:remote && npm run electron:install && electron-builder --projectDir remote-control-app/dist-package --win --x64 --dir --config ../electron-builder.json",
    "dist:remote:win:nsis": "npm run build:remote && npm run electron:install && electron-builder --projectDir remote-control-app/dist-package --win nsis --x64 --config ../electron-builder.json",
    "build:desktop": "cross-env DESKTOP_BUILD=true VITE_PUBLIC_WEB=false npm run build && npm run build:server && node scripts/prepare-desktop-env.mjs && npm run build:desktop:verify",
    "dist:win": "npm run build:desktop && npm run electron:install && electron-builder --win --x64 --config.directories.output=release/win",
    "dist:win:nsis": "npm run build:desktop && npm run electron:install && electron-builder --win nsis --x64 --config.directories.output=release/win",
    "dist:win:unpacked": "npm run build:desktop && npm run electron:install && electron-builder --win --x64 --dir --config.directories.output=release/win",
    "dist:clean": "node -e \"require('fs').rmSync('release',{recursive:true,force:true});require('fs').rmSync('dist-electron',{recursive:true,force:true})\"",
    "build:public": "cross-env VITE_PUBLIC_WEB=true npm run build",
    "supertonic:serve:v3": "cross-env SUPERTONIC_MODEL=supertonic-3 npm run supertonic:serve",
    "supertonic:serve:v2": "cross-env SUPERTONIC_MODEL=supertonic-2 npm run supertonic:serve",
    "supertonic:serve:v1": "cross-env SUPERTONIC_MODEL=supertonic npm run supertonic:serve",
    "audit:i18n": "node scripts/audit-i18n-hardcoded.mjs",
    "dev:vieneu": "node scripts/start-vieneu.mjs",
    "vieneu:serve": "node scripts/start-vieneu.mjs",
    "build:desktop:verify": "node scripts/verify-electron-build.mjs",
    "electron:preview": "npm run build:desktop && npm run electron:install && npx electron .",
    "electron:install": "npm install electron electron-builder --save-dev --ignore-scripts=false --foreground-scripts",
    "electron:dev": "npm run build && electron .",
    "electron:pack": "npm run build && electron-builder --win --dir",
    "electron:dist": "npm run build && electron-builder --win nsis",
    "electron:dist:x64": "npm run build && electron-builder --win nsis --x64",
    "electron:dist:portable": "npm run build && electron-builder --win portable --x64",
    "dev:remotion": "remotion studio src/features/remotion-video/remotion/index.ts --port=3003",
    "remotion:render:test": "remotion render src/features/remotion-video/remotion/index.ts AlgorithmExplainer generated-videos/remotion-test.mp4",
    "dev:gpt-sovits": "node scripts/start-gpt-sovits.mjs",
    "gpt-sovits:serve": "node scripts/start-gpt-sovits.mjs"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-context-menu": "^2.2.15",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-hover-card": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@remotion/bundler": "4.0.515",
    "@remotion/cli": "4.0.515",
    "@remotion/media": "4.0.515",
    "@remotion/player": "4.0.515",
    "@remotion/renderer": "4.0.515",
    "@tanstack/react-query": "^5.83.0",
    "@types/aos": "^3.0.8",
    "@vercel/analytics": "^2.0.1",
    "@xyflow/react": "^12.10.2",
    "aos": "^2.3.4",
    "cannon-es": "^0.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "concurrently": "^10.0.3",
    "cors": "^2.8.6",
    "date-fns": "^3.6.0",
    "dotenv": "^17.4.2",
    "embla-carousel-react": "^8.6.0",
    "express": "^5.2.1",
    "googleapis": "^171.4.0",
    "gsap": "^3.15.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.462.0",
    "mobx": "^6.13.7",
    "mobx-react-lite": "^4.1.0",
    "multer": "^2.1.1",
    "next-themes": "^0.3.0",
    "phaser": "^4.1.0",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.61.1",
    "react-resizable-panels": "^2.1.9",
    "react-router-dom": "^7.18.2",
    "recharts": "^2.15.4",
    "remotion": "4.0.515",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.170.0",
    "vaul": "^0.9.9",
    "ws": "^8.20.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "electron": "^42.11.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.27.1",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "jsdom": "^29.1.1",
    "lovable-tagger": "^1.1.13",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.3.3",
    "vitest": "^4.1.8"
  },
  "main": "electron/main.cjs",
  "description": "Social videos publishing studio.",
  "author": "KAI STUDIO",
  "build": {
    "appId": "vn.kaistudio.app",
    "productName": "KAI STUDIO",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "electron/**/*",
      "package.json",
      "public/**/*"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "dist",
        "to": "desktop-client",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "scripts",
        "to": "electron-runtime/scripts",
        "filter": [
          "vieneu-*.py",
          "*.mjs",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "libs/VieNeu-TTS",
        "to": "electron-runtime/libs/VieNeu-TTS",
        "filter": [
          "**/*",
          "!**/.git/**",
          "!**/.venv/**",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/.mypy_cache/**",
          "!**/.pytest_cache/**"
        ]
      },
      {
        "from": "models",
        "to": "electron-runtime/bundled-models",
        "filter": [
          "**/*.onnx",
          "**/*.onnx.json",
          "!**/*.download",
          "!**/.gitkeep"
        ]
      },
      {
        "from": ".env.example",
        "to": "electron-runtime/.env.example"
      }
    ],
    "asarUnpack": [
      "dist-electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KAI STUDIO"
    }
  }
}
