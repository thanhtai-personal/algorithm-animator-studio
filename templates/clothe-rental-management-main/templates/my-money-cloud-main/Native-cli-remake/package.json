{
  "name": "quanlychitieu",
  "main": "expo-router/entry",
  "version": "0.0.4",
  "versionCode": 1,
  "description": "quanlychitieu",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "dev": "cross-env PORT=8000 npx expo start --dev-client",
    "build:dev": "eas build -p android --profile development --clear-cache",
    "build:dev:ios": "eas build -p ios --profile development --clear-cache",
    "build:preview": "eas build -p android --profile preview --clear-cache",
    "build:android": "eas build -p android --profile production --clear-cache",
    "start:dev": "npm run build:dev && npm run dev",
    "start:dev:ios": "npm run build:dev:ios && npm run dev",
    "prebuild": "npx expo prebuild --clean",
    "run:mobile": "npx expo run:android && npx expo run:ios",
    "export": "eas build --profile preview --platform android --clear-cache"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
