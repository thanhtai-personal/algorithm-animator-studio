# Frontend/runtime overrides
VITE_API_URL=http://localhost:5050
VITE_CLIENT_ORIGIN=https://kai-studio.pro:3000
VITE_PUBLIC_WEB=false
VITE_VERCEL_ANALYTICS=

# Local server/origin overrides
CLIENT_ORIGIN=https://kai-studio.pro:3000
SERVER_ORIGIN=http://localhost:5050
SERVER_DATA_DIR=

# Optional local paths
MODEL_DIR=
PIPER_EXE=
FFMPEG_EXE=
FFPROBE_EXE=
MUSIC_LIBRARY_DIR=

# Voice/API secrets
ELEVENLABS_API_KEY=
AI_SHORTS_API_KEY=
AI_SHORTS_API_URL=https://generativelanguage.googleapis.com/v1beta
AI_AGENT_TEXT_MODEL=gemini-2.0-flash
AI_AGENT_PROVIDER=gemini
OPENAI_API_KEY=

# Provider-specific overrides
#Supertonic
SUPERTONIC_BASE_URL=http://127.0.0.1:6688
SUPERTONIC_MODEL=supertonic-3
SUPERTONIC_HEALTH_ENDPOINT=/v1/health
SUPERTONIC_STYLES_ENDPOINT=/v1/styles
SUPERTONIC_IMPORT_STYLE_ENDPOINT=/v1/styles/import
SUPERTONIC_TTS_ENDPOINT=/v1/tts
# VieNeu (local source under libs/VieNeu-TTS by default)
VIENEU_SOURCE_DIR=libs/VieNeu-TTS
VIENEU_PYTHON=libs/VieNeu-TTS/.venv/Scripts/python.exe
VIENEU_START_MODE=bridge
VIENEU_AUTO_START=true
VIENEU_MODE=turbo
VIENEU_EMOTION=natural
VIENEU_DEFAULT_VOICE_ID=
VIENEU_REFERENCE_AUDIO=
VIENEU_REFERENCE_TEXT=
VIENEU_REMOTE_API_BASE=http://127.0.0.1:23333/v1
VIENEU_REMOTE_MODEL=pnnbao-ump/VieNeu-TTS-v2
VIENEU_TIMEOUT_MS=1200000
# RVC/Applio - local voice conversion provider
RVC_APPLIO_BASE_URL=http://127.0.0.1:6969
RVC_APPLIO_START_COMMAND=
RVC_APPLIO_API_NAME=/infer_convert
RVC_APPLIO_PYTHON=.venv/Scripts/python.exe

# Social provider OAuth
# YouTube OAuth
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=https://kai-studio.pro:3000/channel
#tiktok oauth
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://kai-studio.pro:3000/channel
TIKTOK_SCOPES=user.info.basic,video.upload
#facebook oauth
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=https://kai-studio.pro:3000/channel
FACEBOOK_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts
#instagram oauth
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://kai-studio.pro:3000/channel
INSTAGRAM_SCOPES=instagram_basic,pages_show_list,pages_read_engagement

# Optional OpenAI-compatible scripting overrides
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# YouTube download/transcript tools (Common tools > YouTube Tools)
YOUTUBE_TOOLS_PYTHON=python
YOUTUBE_DLP_EXE=yt-dlp
WHISPER_EXE=whisper
YOUTUBE_TRANSCRIPT_MODEL=base
YOUTUBE_TRANSCRIPT_LANGUAGE=auto
