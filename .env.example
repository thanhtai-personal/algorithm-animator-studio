# Frontend/runtime
VITE_API_URL=http://localhost:5050
VITE_PUBLIC_WEB=false
VITE_DESKTOP_DOWNLOAD_URL=

# Local voice backend
CLIENT_ORIGIN=http://localhost:3000
VITE_NEST_API_BASE_URL=https://kata-center-api.vercel.app/
SERVER_ORIGIN=http://localhost:5050
SERVER_DATA_DIR=server/data
MODEL_DIR=models
PIPER_EXE=models/.venv/Scripts/piper.exe

# ElevenLabs PRO voice
ELEVENLABS_API_KEY=
ELEVENLABS_VOICES=[]

# Supertonic local TTS server
SUPERTONIC_BASE_URL=http://127.0.0.1:7788
SUPERTONIC_MODEL=supertonic-3
SUPERTONIC_DEFAULT_VOICE=M1
SUPERTONIC_DEFAULT_LANG=en
SUPERTONIC_TOTAL_STEPS=8

# YouTube OAuth + upload - read by local/desktop backend only
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/youtube
YOUTUBE_TITLE=Algorithm explained visually
YOUTUBE_DESCRIPTION=Visual programming explanation generated by AlgoShorts Studio.
YOUTUBE_TAGS=algorithm,programming,visualization,code visual lab
YOUTUBE_CATEGORY_ID=27
YOUTUBE_PRIVACY_STATUS=unlisted
YOUTUBE_MADE_FOR_KIDS=false
YOUTUBE_NOTIFY_SUBSCRIBERS=false
YOUTUBE_CONTAINS_SYNTHETIC_MEDIA=true

# MU News AI scripting - optional, server-side only
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
