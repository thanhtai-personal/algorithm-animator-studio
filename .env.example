# Frontend/runtime overrides
VITE_API_URL=
VITE_PUBLIC_WEB=
VITE_VERCEL_ANALYTICS=

# Local server/origin overrides
CLIENT_ORIGIN=
SERVER_ORIGIN=
SERVER_DATA_DIR=

# Optional local paths
MODEL_DIR=
PIPER_EXE=
FFMPEG_EXE=
FFPROBE_EXE=
MUSIC_LIBRARY_DIR=

# Voice/API secrets
ELEVENLABS_API_KEY=
AI_SHORTS_API_KEY=
OPENAI_API_KEY=

# Provider-specific overrides
#Supertonic
SUPERTONIC_BASE_URL=
SUPERTONIC_MODEL=
SUPERTONIC_HEALTH_ENDPOINT=/v1/health
SUPERTONIC_STYLES_ENDPOINT=/v1/styles
SUPERTONIC_IMPORT_STYLE_ENDPOINT=/v1/styles/import
SUPERTONIC_TTS_ENDPOINT=/v1/tts
# Vieneu (local or remote)
# Fork/clone VieNeu-TTS source to this path, then create .venv inside it.
VIENEU_SOURCE_DIR=C:/DATA/working/sources/VieNeu-TTS
VIENEU_PYTHON=C:/DATA/working/sources/VieNeu-TTS/.venv/Scripts/python.exe
VIENEU_REFERENCE_AUDIO=
VIENEU_REFERENCE_TEXT=
# RVC/Applio - local voice conversion provider
RVC_APPLIO_BASE_URL=
RVC_APPLIO_START_COMMAND=
RVC_APPLIO_PYTHON=

# Social provider OAuth
# YouTube OAuth
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
#tiktok oauth
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
#facebook oauth
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
#instagram oauth
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Optional OpenAI-compatible scripting overrides
OPENAI_CHAT_MODEL=
OPENAI_BASE_URL=
