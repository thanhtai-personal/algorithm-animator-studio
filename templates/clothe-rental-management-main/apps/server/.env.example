# Runtime
NODE_ENV=development
PORT=3056
NEST_API_BASE_URL=http://localhost:3056
ZALO_MINI_APP_API_BASE_URL=http://localhost:3056
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Supabase (required)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Fallback aliases (optional)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mini App
ZALO_MINI_APP_APP_SECRET=
ZALO_MINI_APP_WEBHOOK_SECRET=
ZALO_MINI_APP_DEBUG=1
ZALO_MINI_APP_DEV_PROFILE_ID=

# Auth / email sender
ENABLED_EMAIL_SENDER=false
NEXT_PUBLIC_ENABLED_EMAIL_SENDER=false
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Media
MEDIA_STORAGE_LIMIT_BYTES=9663676416
NEXT_PUBLIC_PRODUCT_IMAGE_BUCKET=product-images

# Observability
API_LOG_WARN_LATENCY_MS=1200
SWAGGER_ENABLED=1
SWAGGER_PATH=api/docs
SWAGGER_JSON_PATH=api/docs-json

# Voice transcription (optional)
VOICE_TRANSCRIPTION_API_KEY=
OPENAI_API_KEY=
VOICE_TRANSCRIPTION_API_BASE_URL=https://api.openai.com/v1
VOICE_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
VOICE_TRANSCRIPTION_PROMPT=
