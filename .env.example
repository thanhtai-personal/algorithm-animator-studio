# Frontend/runtime overrides
VITE_API_URL=http://localhost:5050
VITE_CLIENT_ORIGIN=http://localhost:3000
VITE_PUBLIC_WEB=false
VITE_VERCEL_ANALYTICS=

# Local server/origin overrides
CLIENT_ORIGIN=http://localhost:3000
SERVER_ORIGIN=http://localhost:5050
SERVER_DATA_DIR=

# Optional local paths
MODEL_DIR=
PIPER_EXE=
FFMPEG_EXE=
FFPROBE_EXE=
MUSIC_LIBRARY_DIR=

# Voice/API secrets
ELEVENLABS_API_KEY=
OPENAI_API_KEY=

# Provider-specific overrides
#Supertonic
SUPERTONIC_BASE_URL=http://127.0.0.1:6688
SUPERTONIC_MODEL=supertonic-3
SUPERTONIC_HEALTH_ENDPOINT=/v1/health
SUPERTONIC_STYLES_ENDPOINT=/v1/styles
SUPERTONIC_IMPORT_STYLE_ENDPOINT=/v1/styles/import
SUPERTONIC_TTS_ENDPOINT=/v1/tts
# VieNeu (optional external checkout; clone to ../VieNeu-TTS, not into this repo)
VIENEU_SOURCE_DIR=../VieNeu-TTS
VIENEU_PYTHON=../VieNeu-TTS/.venv/Scripts/python.exe
VIENEU_START_MODE=bridge
VIENEU_AUTO_START=false
VIENEU_MODE=turbo
VIENEU_EMOTION=natural
VIENEU_DEFAULT_VOICE_ID=
VIENEU_REFERENCE_AUDIO=
VIENEU_REFERENCE_TEXT=
VIENEU_REMOTE_API_BASE=http://127.0.0.1:23333/v1
VIENEU_REMOTE_MODEL=pnnbao-ump/VieNeu-TTS-v2
VIENEU_TIMEOUT_MS=1200000
# RVC/Applio - local voice conversion provider
RVC_APPLIO_BASE_URL=http://127.0.0.1:6969
RVC_APPLIO_START_COMMAND=
RVC_APPLIO_API_NAME=/infer_convert
RVC_APPLIO_PYTHON=.venv/Scripts/python.exe


# Provider startup gates (Provider Manager). Restart app/dev server after changing.
KAI_PROVIDER_SUPERTONIC_ENABLED=false
KAI_PROVIDER_APPLIO_ENABLED=false
KAI_PROVIDER_VIENEU_ENABLED=false
KAI_PROVIDER_GPT_SOVITS_ENABLED=false

# GPT-SoVITS - local experimental voice cloning provider
GPT_SOVITS_BASE_URL=http://127.0.0.1:9880
GPT_SOVITS_START_COMMAND=
GPT_SOVITS_SOURCE_DIR=../GPT-SoVITS
GPT_SOVITS_PYTHON=python
GPT_SOVITS_TTS_ENDPOINT=/tts
GPT_SOVITS_TEXT_LANG=en
GPT_SOVITS_PROMPT_LANG=en
GPT_SOVITS_REFERENCE_AUDIO=
GPT_SOVITS_PROMPT_TEXT=
GPT_SOVITS_MEDIA_TYPE=wav
GPT_SOVITS_TEXT_SPLIT_METHOD=cut5
GPT_SOVITS_TIMEOUT_MS=300000

# Optional OpenAI-compatible scripting overrides
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional local Whisper for Timeline auto-lyrics (no YouTube tools)
WHISPER_PYTHON=python
WHISPER_EXE=whisper
